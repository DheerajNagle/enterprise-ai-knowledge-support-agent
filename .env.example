# ==============================================================================
# Enterprise AI Knowledge & Support Agent - Environment Configuration
# ==============================================================================

# Application Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security & API Authentication
# Secret key used to authenticate requests to the API gateway (Header: X-API-Key)
API_KEY=replace-with-your-secure-api-key

# Google Gemini / LLM Configuration
# Required for Gemini LLM reasoning and embedding generation
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Qdrant Vector Database
# URL of the Qdrant instance (e.g., http://localhost:6333 or Qdrant Cloud URL)
QDRANT_URL=http://localhost:6333
# API key for Qdrant Cloud (optional for local unauthenticated instances)
QDRANT_API_KEY=

# Vector Database Collection & Retrieval Settings
QDRANT_COLLECTION_NAME=enterprise_knowledge_base
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
SIMILARITY_THRESHOLD=0.72
TOP_K=5
